datasource db {
  provider = "postgresql"
  schemas  = ["financeiro"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "multiSchema"]
}

enum TransactionType {
  INCOME
  EXPENSE
  @@schema("financeiro")
}

enum CategoryType {
  INCOME
  EXPENSE
  BOTH
  @@schema("financeiro")
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
  @@schema("financeiro")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  type        TransactionType
  amount      Decimal
  description String
  date        DateTime
  categoryId  String          @db.Uuid
  category    Category        @relation(fields: [categoryId], references: [id])
  accountId   String          @db.Uuid
  account     Account         @relation(fields: [accountId], references: [id])
  userId      String          @db.Uuid
  tags        String[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@schema("financeiro")
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  icon         String
  color        String
  type         CategoryType
  userId       String?       @db.Uuid
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@schema("financeiro")
}

model Account {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  type         AccountType
  balance      Decimal
  currency     String        @default("BRL")
  userId       String        @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@schema("financeiro")
}

model Budget {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @db.Uuid
  amount     Decimal
  month      Int
  year       Int
  userId     String   @db.Uuid
  createdAt  DateTime @default(now())

  @@schema("financeiro")
}
